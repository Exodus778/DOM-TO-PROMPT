{
  "manifest_version": 3,
  "name": "DOM to Prompt - AI Inspector",
  "version": "1.0.0",
  "description": "Inspect any web element and copy clean, context-rich LLM prompts.",
  "permissions": ["activeTab", "scripting"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["overlay.css"]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
